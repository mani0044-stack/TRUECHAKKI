# Production build only - forces all API calls to the canonical www host.
# Vercel redirects the bare apex domain (truechakki.com) to www.truechakki.com,
# but the redirect responses carry no CORS headers, which breaks fetch() from
# pages that boot on the apex host. www.truechakki.com/api answers with
# Access-Control-Allow-Origin: * so even cross-origin callers are allowed.
VITE_API_BASE_URL="https://www.truechakki.com/api"